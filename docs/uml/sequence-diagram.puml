@startuml sequence-diagram
' Restaurant Rush - Stage 3 scenario: VIP customer C3 with Happy Hour.
' Mirrors turns 7-11 of tests/stage3-victory.txt, then the final result check.
' Manager choice that changes the outcome: switching Happy Hour on in turn 7
' locks C3's bill at $12.96 instead of $16.20, and C3 recovers satisfaction in turn 8.
skinparam shadowing false
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 220
autonumber "<b>0."
title Restaurant Rush - Sequence: VIP order with Happy Hour, from arrival to payment and result

actor Manager
boundary ":ConsoleUI" as UI
control ":GameController" as GC
participant ":ArrivalSchedule" as AS
participant ":HappyHour" as HH
participant ":Host" as Host
participant ":Waiter" as W
participant ":Chef" as Chef
participant ":Cashier" as Cash
participant ":Restaurant" as R
participant ":PriceCalculator" as PC
participant "c3:VIPCustomer" as C3
participant "o3:Order" as O3
participant ":GameStats" as GS

loop for turn = 1 .. 18  [hasNextTurn()]
  UI -> GC : beginTurn()

  group Turn 7 - arrival, Happy Hour, seating, order, first cooking unit
    GC -> AS : arrivalFor(7)
    AS -> C3 ** : new VIPCustomer(3, 7)
    AS --> GC : c3
    GC -> R : admit(c3)
    note right of C3 : status = WAITING\nsatisfaction = 100
    GC -> HH : applyRecovery(restaurant)
    HH --> GC : [] (not active yet)
    GC --> UI : events
    UI -> UI : showStatus()
    opt canActivateHappyHour()
      Manager -> UI : 1 (switch Happy Hour on)
      UI -> GC : activateHappyHour()
      alt no staff has acted this turn
        GC -> HH : activate()
        HH --> GC : ok (remainingTurns = 2)
        GC -> HH : applyRecovery(restaurant)
        HH -> C3 : recoverSatisfaction(15)
        note right of C3 : capped at 100
      else a staff member already acted
        GC --> UI : fail("only at the start of a turn")
      end
      GC --> UI : ActionResult
    end
    Manager -> UI : Host: seat C3
    UI -> GC : hostSeat(c3)
    GC -> Host : seat(c3, restaurant)
    Host -> R : seatCustomer(c3)
    alt free table exists
      R -> C3 : seatAt(table1)
      note right of C3 : SEATED
      R --> Host : ok
    else all tables occupied
      R --> Host : fail("No free table")
      note over UI : reason shown, task not used up,\nmanager chooses again
    end
    Host --> GC : ActionResult
    GC --> UI : ActionResult
    Manager -> UI : Waiter: take C3's order
    UI -> GC : waiterTakeOrder(c3)
    GC -> W : takeOrder(c3, restaurant, pricing, 7)
    W -> C3 : chooseMenuItem(menu)
    C3 --> W : Pasta (cycling rule: customer 3)
    W -> PC : quote(c3, Pasta)
    PC -> C3 : adjustBill(1800)
    note right of C3 : <b>polymorphism</b>: VIPCustomer\noverrides adjustBill: 10% off
    C3 --> PC : 1620
    loop for each PricingPolicy
      PC -> HH : apply(1620)
      HH --> PC : 1296 [isActive(): 20% off]
    end
    PC --> W : 1296
    W -> R : createOrder(c3, Pasta, 1296, 7)
    R -> O3 ** : new Order(3, c3, Pasta, 1296, 7)
    note right of O3 : IN_PREPARATION 0/2\nprice locked at $12.96
    R --> W : o3
    W -> C3 : placeOrder(o3)
    W --> GC : ok("orders Pasta, bill $12.96")
    GC --> UI : ActionResult
    Manager -> UI : Chef: work on Order #3
    UI -> GC : chefPrepare(o3)
    GC -> Chef : prepare(o3, 7)
    Chef -> O3 : prepareOneUnit(7)
    note right of O3 : 1/2 units
    Chef --> GC : ok
    UI -> GC : endTurn()
    GC -> C3 : loseSatisfactionForWaiting()
    note right of C3 : -5 (VIP rate): 95
    GC -> HH : endTurn()
    note right of HH : remainingTurns = 1
  end

  group Turn 8 - recovery, dish becomes READY
    UI -> GC : beginTurn()
    GC -> HH : applyRecovery(restaurant)
    HH -> C3 : recoverSatisfaction(15)
    note right of C3 : still waiting for food: 95 -> 100
    Manager -> UI : Chef: work on Order #3
    UI -> GC : chefPrepare(o3)
    GC -> Chef : prepare(o3, 8)
    Chef -> O3 : prepareOneUnit(8)
    note right of O3 : 2/2 units -> READY (readyTurn = 8)
    UI -> GC : endTurn()
    GC -> C3 : loseSatisfactionForWaiting()
    note right of C3 : 95
    GC -> HH : endTurn()
    note right of HH : remainingTurns = 0: Happy Hour ends
  end

  group Turn 9 - READY -> SERVED
    Manager -> UI : Waiter: serve Order #3
    UI -> GC : waiterServe(o3)
    GC -> W : serve(o3, 9)
    W -> O3 : isReadyToServe(9)
    alt READY on an earlier turn
      O3 --> W : true
      W -> O3 : markServed()
      note right of O3 : SERVED
      W -> C3 : receiveFood(9)
      C3 -> C3 : reactToService(2)
      note right of C3 : EATING; VIP inherits the\ndefault (no reaction).\nA Critic would get +/-10 here.
      W --> GC : ok
      GC -> GS : recordServed()
    else not READY yet (or READY only this turn)
      W --> GC : fail("not READY yet")
    end
    UI -> GC : endTurn()
    note over GC, C3 : c3 is served, so it loses no satisfaction (95)
  end

  group Turn 10 - eating finishes
    UI -> GC : endTurn()
    GC -> C3 : finishEatingIfDone(10)
    note right of C3 : READY_TO_PAY (readyToPayTurn = 10)
    GC -> Cash : collectPayment(restaurant, 10)
    Cash -> R : getCustomersAbleToPay(10)
    R --> Cash : [] (c3 became READY_TO_PAY this turn)
  end

  group Turn 11 - payment
    UI -> GC : endTurn()
    GC -> Cash : collectPayment(restaurant, 11)
    Cash -> R : getCustomersAbleToPay(11)
    R --> Cash : [c3] (oldest first)
    opt someone can pay and the Cashier is free
      Cash -> C3 : pay()
      C3 -> O3 : markPaid()
      C3 -> C3 : leaveTable()
      note right of C3 : PAID, satisfaction 95 recorded,\ntable 1 released
      C3 --> Cash : 1296
      Cash --> GC : c3
      GC -> GS : recordPayment(1296, 95)
    end
    GC -> R : getCustomersWaitingForService()
    loop for each customer still waiting (c3 is not: it has paid)
      note over GC, R : customer.loseSatisfactionForWaiting()
      opt satisfaction reached 0
        GC -> R : removeUnhappyCustomer(customer)
      end
    end
  end
end

UI -> GC : getResult()
GC -> GS : evaluate(config)
alt paid >= 4 and revenue >= $45.00 and average satisfaction >= 60
  GS --> GC : VICTORY
else any target missed
  GS --> GC : DEFEAT
end
GC --> UI : result
UI -> Manager : showFinalResult()\n(this run: 5 paid, $85.86, avg 86.6 -> VICTORY)
@enduml
